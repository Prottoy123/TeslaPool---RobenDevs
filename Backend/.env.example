# Dhaka Tesla Pool Environment Configuration Example
# Do not commit real secrets to source control

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Prisma)
# Local development using Prisma Dev Server or standard PostgreSQL:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Or standard PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/teslapool?schema=public"

# Security & Authentication
JWT_SECRET="dhaka-tesla-pool-super-secret-jwt-key-2026"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma separated or * for all in development)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
